{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMSLite",
  "version": "1.0.0",
  "identifier": "com.lite.pms",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PMS Lite",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/pmslogo.png"
    ],
    "resources": [
      "../python/**/*"
    ]
  }
}